APP_IMAGE=ghcr.io/plutolabsapps/korekto:latest
APP_PORT=3010

NUXT_PUBLIC_SITE_NAME=Korekto
NUXT_PUBLIC_SITE_URL=https://korekto.plutolabs.app

NUXT_OBJECT_STORAGE_ENDPOINT=https://fsn1.your-objectstorage.com
NUXT_OBJECT_STORAGE_REGION=fsn1
NUXT_OBJECT_STORAGE_BUCKET=korekto
NUXT_OBJECT_STORAGE_ACCESS_KEY_ID=
NUXT_OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Production: `openssl rand -hex 32`
POSTGRES_USER=korekto
POSTGRES_PASSWORD=korekto
POSTGRES_DB=korekto
# Host port for local development
DB_PORT=5432
NUXT_DATABASE_URL=postgres://korekto:korekto@localhost:5432/korekto
